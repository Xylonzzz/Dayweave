PORT=3088
HOST=127.0.0.1
# sqlite (default, Node.js 24+) or mysql (Node.js 22.2+)
DB_DRIVER=sqlite
# MySQL 5.7 uses a dedicated empty database in your existing MySQL instance.
# See .env.mysql.example and docs/WINDOWS_MYSQL.md.
# 云端部署时改成实际 HTTPS 域名，HOST 改为 0.0.0.0
PUBLIC_ORIGIN=http://localhost:3088
ADMIN_USER=student
# 第一次启动可指定密码；留空则在 data/bootstrap.txt 生成初始密码
ADMIN_PASSWORD=
# 可选的邮件备用提醒
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
VAPID_SUBJECT=mailto:admin@example.com
# 自建服务器 + Caddy 时填写；Railway 托管不需要此项
SITE_DOMAIN=

# Optional: built DeepSeek Harness 0.1.0-rc.5 checkout (absolute path)
HARNESS_ROOT=

# AI development: local (default), disabled, or enabled for authenticated remote access
SHIXU_DEVELOPMENT=local

# Optional absolute Docker CLI path, when not in PATH
# SHIXU_DOCKER_PATH=C:/Program Files/Docker/Docker/resources/bin/docker.exe
