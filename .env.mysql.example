# Copy to .env, fill locally, and never commit the real .env.
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dayweave
MYSQL_USER=dayweave
MYSQL_PASSWORD=
# For a remote TLS database, set the trusted CA certificate path.
MYSQL_SSL_CA=

HOST=127.0.0.1
PORT=3088
# First test locally. When configuring Nginx HTTPS, replace with its exact origin.
PUBLIC_ORIGIN=http://localhost:3088
DATA_DIR=C:/DayweaveData
ADMIN_USER=student
# Leave empty to generate initial credentials in DATA_DIR/bootstrap.txt.
ADMIN_PASSWORD=
VAPID_SUBJECT=mailto:admin@example.com

# A cloud sync server does not need the AI code-execution environment.
SHIXU_DEVELOPMENT=disabled
